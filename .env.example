# MySQL/MariaDB local.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/pedidos_integracao"

# Banco usado pelos testes de integração. É limpo a cada execução.
# Se não for informado, o helper deriva DATABASE_URL trocando o nome para *_test.
TEST_DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/pedidos_integracao_test"

PORT=3000

# Docker Compose: credenciais do MySQL criado pelo serviço `db`.
# A API monta o DATABASE_URL sozinha a partir destes valores.
MYSQL_ROOT_PASSWORD="root"
MYSQL_DATABASE="pedidos_integracao"
MYSQL_USER="pedidos_app"
MYSQL_PASSWORD="senha"
# Porta publicada no host (3307 evita conflito com MySQL/MariaDB local em 3306).
MYSQL_PORT=3306
