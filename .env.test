# Ambiente de desenvolvimento + testes (Vitest/Supertest) apontando para o
# MySQL do Docker Compose (serviço `db`, publicado em localhost:3307).
#
# Uso:
#   cp .env.test .env          # desenvolvimento e testes com o banco do Compose
#   npm run test:e2e           # .env.test é carregado automaticamente nos testes
#
# Para usar o MySQL instalado na máquina, troque a porta 3307 por 3306.

# Banco de desenvolvimento usado pela API.
DATABASE_URL="mysql://pedidos_app:senha@127.0.0.1:3307/pedidos_integracao"

# Banco dos testes de integração. Precisa terminar com "_test": o helper recria
# o schema com `prisma db push --force-reset` antes de cada suíte.
TEST_DATABASE_URL="mysql://pedidos_app:senha@127.0.0.1:3307/pedidos_integracao_test"

PORT=3333
